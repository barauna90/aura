# ---------- Banco / infra ----------
DATABASE_URL=postgresql://sipenem:sipenem@localhost:5432/sipenem?schema=public
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Object storage (S3 compatível) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sip-enem-official-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Em desenvolvimento sem MinIO os PDFs podem ser servidos de ./storage
LOCAL_STORAGE_DIR=./storage

# ---------- IA (provider abstrato) ----------
# mock | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_ESSAY_MODEL=claude-opus-5

# ---------- Pagamentos (provider abstrato) ----------
# mock | (implemente outro gateway brasileiro em apps/api/src/modules/payments/providers)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=troque-este-segredo-de-webhook

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
